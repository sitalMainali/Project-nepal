# ─────────────────────────────────────────────────────────────────────────────
# Second Serve Mail: environment variables
# Copy to .env.local for local dev. On Vercel: Project → Settings → Environment Variables.
# Variables starting with NEXT_PUBLIC_ are visible in the browser. Never put secrets in them.
# ─────────────────────────────────────────────────────────────────────────────

# Production URL, no trailing slash. Used for SEO, sitemap, canonical URLs and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.secondservemail.com.au

# Booking calendar (Cal.com or Calendly). Overrides site.bookingUrl in src/content.ts.
# e.g. https://cal.com/your-name/guest-list-audit  or  https://calendly.com/your-name/audit
NEXT_PUBLIC_BOOKING_URL=

# ── Email (Resend: https://resend.com) ──────────────────────────────────────
# Without these, leads are still stored but no emails are sent (logged instead).
RESEND_API_KEY=
# Must be on a domain you've verified in Resend, e.g. "Second Serve Mail <hello@secondservemail.com.au>"
EMAIL_FROM=
# Where new-lead notifications go (your inbox).
LEAD_NOTIFY_EMAIL=

# ── Lead storage (Google Sheet via Apps Script) ─────────────────────────────
# See docs/google-sheets-apps-script.js. Without this, leads are written to
# .data/leads.jsonl locally and to the server log on Vercel.
SHEETS_WEBHOOK_URL=
# Any long random string. Must match SECRET in the Apps Script.
SHEETS_WEBHOOK_SECRET=

# ── Spam protection (Cloudflare Turnstile: https://dash.cloudflare.com → Turnstile) ──
# Leave both empty to disable (local dev). Set BOTH in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Max form submissions per IP per 10 minutes (per server instance). Default 5.
RATE_LIMIT_MAX=5

# ── Analytics (loaded only after cookie consent) ────────────────────────────
# Set one or both. If neither is set, the cookie banner is not shown.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: custom Plausible script URL (self-hosted or proxied).
NEXT_PUBLIC_PLAUSIBLE_SRC=
# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
